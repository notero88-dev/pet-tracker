<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Besti</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>pettrack_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ─── Permissions (Spanish, Colombia mass-market) ───────────── -->
	<!-- Required by `location` package. iOS hard-crashes the app at
	     first location request if this string is absent. Shown in the
	     OS-level permission dialog the first time A6 Pick Location
	     resolves the phone's GPS as the initial map center. -->
	<!-- iOS uses this string for TWO things, both rendered in the same
	     system prompt when we call requestPermission():
	       1. Centering the map when configuring zona segura.
	       2. Reading the home WiFi BSSID during onboarding
	          (com.apple.developer.networking.HotspotConfiguration —
	          iOS gates BSSID behind location auth, not just the
	          entitlement; see 2026-05-11 phone-side home zone plan). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Besti usa tu ubicación para centrar el mapa y detectar tu red Wi-Fi de casa al configurar la zona de tu mascota.</string>

	<!-- ALWAYS variant required by Apple's static analyzer because one of
	     our linked iOS plugins (likely `geolocator` or the Google Maps
	     SDK) references the `CLAuthorizationStatus.authorizedAlways`
	     symbol — even though Besti today only requests WhenInUse and
	     never escalates to Always. Apple's automated review (Transporter
	     warning 90683 on 2026-05-20 build 2) requires the purpose string
	     to exist whenever the symbol is linked, regardless of whether we
	     actually call requestAlwaysAuthorization. Shipped 2026-05-20 to
	     unblock build 3 submission. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Besti puede usar tu ubicación en segundo plano para alertarte si tu mascota sale de la zona segura aunque tengas la app cerrada.</string>

	<!-- Required by `mobile_scanner` for QR-code scanning during A4
	     onboarding. Without this, mobile_scanner throws and the camera
	     view never appears. -->
	<key>NSCameraUsageDescription</key>
	<string>Besti necesita la cámara para escanear el código QR de tu dispositivo.</string>

	<!-- Required by `image_picker` even if photo selection is deferred,
	     because the package's iOS plugin queries permission at init
	     time on some iOS versions. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Besti puede usar tu galería si decides agregar una foto de tu mascota.</string>

	<!-- ─── Background modes for push notifications ──────────────── -->
	<!-- Required for FCM background delivery. Pairs with the
	     "Push Notifications" capability you must enable in Xcode
	     (Signing & Capabilities tab). See:
	     pettrack-backend/docs/runbooks/ios-first-build.md -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>

	<!-- ─── App Transport Security ───────────────────────────────── -->
	<!-- No exceptions needed as of 2026-05-13. All three backend
	     services (provisioning-api, push-service, Traccar) are served
	     at https://api.mybesti.co behind nginx with a Let's Encrypt
	     cert. iOS ATS defaults are honored — no plaintext, no self-
	     signed cert, no IP-pinned exception. -->

	<!-- ─── Export compliance ────────────────────────────────────── -->
	<!-- TLS is the only "encryption" the app uses (HTTPS to
	     api.mybesti.co + APNs/FCM push). That qualifies for the
	     §740.17(b)(1) BIS export-compliance exemption ("ancillary use
	     of cryptography"). Declaring it here lets Apple flag every
	     TestFlight + App Store build as exempt automatically, so we
	     don't have to upload an export-compliance document for every
	     release. If we ever add real cryptography (custom symmetric
	     ciphers, end-to-end-encrypted messaging, etc.), flip this to
	     <true/> and fill out the export-compliance questionnaire in
	     App Store Connect → App Information → Encryption Export
	     Compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ─── Google Sign-In OAuth callback URL scheme ─────────────── -->
	<!-- Required by the `google_sign_in` iOS plugin. The string below is
	     the REVERSED_CLIENT_ID from GoogleService-Info.plist. After the
	     user authorizes Google in the in-app Safari view, Google redirects
	     to this scheme so iOS can route the OAuth response back into the
	     app. If you regenerate the Firebase iOS app config, update this
	     scheme to match the new REVERSED_CLIENT_ID — otherwise sign-in
	     hangs forever after Google's auth screen. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.487348630652-0am4lmo6ij7kn915h61pr66tk98pthdr</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
